# ==============================================================================
# LogSphere Environment Configuration Template (.env.example)
#
# Copy this file to .env or configure these variables in your deployment
# environment (e.g. systemd, Docker, Kubernetes secrets, CI/CD masked variables).
# DO NOT COMMIT .env OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# --- Application Profiles ---
# Options: default, dev-h2, prod
SPRING_PROFILES_ACTIVE=prod

# --- Server Configuration ---
PORT=8083

# --- Database Configuration (MySQL) ---
# In production, DB_URL, DB_USERNAME, and DB_PASSWORD are REQUIRED and have no defaults.
DB_URL=jdbc:mysql://localhost:3306/logsphere?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# --- Mail / SMTP Configuration ---
# In production, MAIL_USERNAME and MAIL_PASSWORD are REQUIRED.
# For Gmail, generate a 16-character App Password under Google Account Security.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username@example.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM=noreply@yourdomain.com

# --- File Storage ---
FILE_UPLOAD_DIR=uploads

# --- Security & Data Seeding ---
# Set to 'false' in production to prevent seeding demo accounts (admin123, hr123, etc.)
SEED_DEMO_USERS=false

# --- Session & Cookie Security ---
# Idle session timeout (e.g. 15m, 30m, 1h). Default is 30m.
SESSION_TIMEOUT=30m
# Set to 'true' in HTTPS production environments, 'false' for local HTTP development.
SESSION_COOKIE_SECURE=true

# --- CORS & Browser Security ---
# Comma-separated allowed origins. Leave blank to enforce strict same-origin policy.
CORS_ALLOWED_ORIGINS=https://crm.yourdomain.com

