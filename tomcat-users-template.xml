<tomcat-users>
<!--
  NOTE:  By default, no user is included in the "manager-gui" role required
  to operate the "/manager/html" web application.  If you wish to use this app,
  you must define such a user - the username and password are arbitrary. It is
  strongly recommended that you do NOT use one of the users in the commented out
  section below since they are intended for use with the examples web
  application.
-->

<!-- LogSphere Deployment Configuration Template -->
<!-- SECURITY WARNING: Never deploy default credentials in any environment! -->
<!-- Configure unique, strong credentials in production. -->

<role rolename="manager-gui"/>
<role rolename="manager-script"/>
<role rolename="manager-jmx"/>
<role rolename="manager-status"/>
<role rolename="admin-gui"/>
<role rolename="admin-script"/>

<!-- Example configuration (replace placeholders before enabling):
<user username="CHANGE_ME_ADMIN_USER" password="CHANGE_ME_STRONG_PASSWORD" roles="manager-gui,manager-script,manager-jmx,manager-status,admin-gui,admin-script"/>
-->

</tomcat-users>
